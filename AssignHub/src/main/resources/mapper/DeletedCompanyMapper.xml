<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.assignhub.mapper.DeletedCompanyMapper">

	<resultMap id="companyResultMap" type="com.assignhub.entity.Company">
		<id property="companyId" column="company_id" />
		<result property="companyName" column="company_name" />
		<result property="companyNameKana" column="company_name_kana" />
		<result property="companyZipCode" column="company_zipcode" />
		<result property="companyAddress1" column="company_address1" />
		<result property="companyAddress2" column="company_address2" />
		<result property="companyTel" column="company_tel" />
		<result property="companyFax" column="company_fax" />
		<result property="foundedYear" column="founded_year" />
		<result property="employeeCount" column="employee_count" />
		<result property="repLastName" column="rep_lastname" />
		<result property="repLastNameKana" column="rep_lastname_kana" />
		<result property="repFirstName" column="rep_firstname" />
		<result property="repFirstNameKana" column="rep_firstname_kana" />
		<result property="createdAt" column="created_at" />
		<result property="updatedAt" column="updated_at" />
		<result property="deleteFlg" column="delete_flg" />
	</resultMap>

	<select id="findAll" resultMap="companyResultMap">
		SELECT * FROM m_company
		<where>
			delete_flg = 1                              
			<if test="companyName != null and companyName != ''">
				AND company_name LIKE CONCAT('%', #{companyName}, '%')                               
			</if>                                               
			<if test="companyTel != null and companyTel != ''">
				AND company_tel LIKE CONCAT('%', #{companyTel}, '%')                               
			</if>                                               
		</where>
		ORDER BY company_id ASC                  
	</select>

	<select id="findByIds" resultMap="companyResultMap">
		SELECT *
		FROM m_company
		WHERE delete_flg = 1
		AND company_id IN
		<foreach item="id" collection="ids" open="(" separator="," close=")">
			#{id}
		</foreach>
	</select>

	<update id="restore">
		UPDATE m_company
		SET delete_flg = 0
		WHERE company_id = #{id} AND delete_flg = 1
	</update>

	<update id="restoreBulk">
		UPDATE m_company
		SET delete_flg = 0
		WHERE company_id IN
		<foreach item="id" collection="ids" open="(" separator="," close=")">
			#{id}
		</foreach>
		AND delete_flg = 1
	</update>

	<delete id="physicalDelete">
		DELETE FROM m_company
		WHERE company_id = #{id}
	</delete>

	<delete id="physicalDeleteBulk">
		DELETE FROM m_company
		WHERE company_id IN
		<foreach item="id" collection="ids" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>

	<select id="countEmployeesByCompanyId" resultType="int">
		SELECT COUNT(*)
		FROM m_employee
		WHERE dispatch_company_id = #{id} OR partner_company_id = #{id}
	</select>

	<select id="countEmployeesByCompanyIds" resultType="int">
		SELECT COUNT(*)
		FROM m_employee
		WHERE dispatch_company_id IN
		<foreach item="id" collection="ids" open="(" separator="," close=")">
			#{id}
		</foreach>
		OR partner_company_id IN
		<foreach item="id" collection="ids" open="(" separator="," close=")">
			#{id}
		</foreach>
	</select>

	<select id="countAssignmentsByCompanyId" resultType="int">
		SELECT COUNT(*)
		FROM t_assignment
		WHERE client_company_id = #{id}
	</select>

	<select id="countAssignmentsByCompanyIds" resultType="int">
		SELECT COUNT(*)
		FROM t_assignment
		WHERE client_company_id IN
		<foreach item="id" collection="ids" open="(" separator="," close=")">
			#{id}
		</foreach>
	</select>

</mapper>