<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.assignhub.mapper.AccountMapper">
	<resultMap id="accountResultMap"
		type="com.assignhub.entity.Account">
		<id property="accountId" column="account_id" />
		<result property="loginId" column="login_id" />
		<result property="permission" column="permission" />
		<result property="passwordHash" column="password_hash" />
		<result property="createdAt" column="created_at" />
		<result property="updatedAt" column="updated_at" />
		<association property="employee"
			javaType="com.assignhub.entity.Employee">
			<id property="employeeId" column="employee_id" />
			<result property="lastName" column="last_name" />
			<result property="firstName" column="first_name" />
		</association>
	</resultMap>
	<select id="findAll" resultMap="accountResultMap">
		SELECT a.*, e.last_name, e.first_name
		FROM
		m_account a
		left JOIN
		m_employee e ON
		a.account_id = e.emp_id
		AND (e.delete_flg = 0 OR
		e.delete_flg IS NULL)

		<where>
			a.delete_flg = 0

			<if test="keyword != null and keyword != ''">
				AND (
				e.first_name LIKE CONCAT('%', #{keyword}, '%')
				OR
				e.last_name
				LIKE CONCAT('%', #{keyword}, '%')
				)
			</if>
			<if test="permission != null">
				AND permission = #{permission}
			</if>
		</where>
		ORDER BY a.account_id ASC
	</select>
	
	<select id="findByLoginId" resultType="com.assignhub.entity.Account">
    SELECT * FROM m_account
    WHERE login_id = #{loginId}
    AND delete_flg = 0
    LIMIT 1
</select>
</mapper>