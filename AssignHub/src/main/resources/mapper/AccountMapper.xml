<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.assignhub.mapper.AccountMapper">

	<resultMap id="accountResultMap"
		type="com.assignhub.entity.Account">
		<id property="accountId" column="account_id" />
		<result property="loginId" column="login_id" />
		<result property="permission" column="permission" />
		<result property="empName" column="emp_name" />
	</resultMap>
	
	<select id="findAll" resultMap="accountResultMap">
		SELECT a.*, e.emp_name
		FROM m_account a 
		INNER JOIN m_employee e ON a.account_id = e.emp_id
		
		<if test="keyword != null and keyword != ''">
			<where>
				emp_name LIKE CONCAT('%', #{keyword}, '%')
			</where>
		</if>
		ORDER BY ${sort} ${order}
	</select>
	
</mapper>