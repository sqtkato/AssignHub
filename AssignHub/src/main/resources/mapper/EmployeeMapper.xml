<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.assignhub.mapper.EmployeeMapper">

	<resultMap id="employeeResultMap"
		type="com.assignhub.entity.Employee">
		<id property="empId" column="emp_id" />
		<result property="empName" column="emp_name" />
		<result property="hireYear" column="hire_year" />
		<result property="createdAt" column="created_at" />
		<result property="updatedAt" column="updated_at" />
	</resultMap>

	<select id="findAll" resultMap="employeeResultMap">
		SELECT * FROM m_employee
		<where>
		<if test="empName != null and empName != ''"> AND emp_name LIKE CONCAT('%', #{empName}, '%')</if>
		<if test="empAssignCompany != null and empAssignCompany != ''"> AND emp_assign_company = #{empAssignCompany}</if>
		<if test="empEngineerType != null and empEngineerType != ''"> AND emp_engineer_type = #{empEngineerType}</if>
		<if test="empCompany != null and empCompany != ''"> AND emp_company = #{empCompany}</if>
		</where>
	</select>

	<select id="findById" resultMap="employeeResultMap">
		SELECT *
		FROM m_employee
		WHERE
		emp_id = #{id}
	</select>

	<insert id="insert" useGeneratedKeys="true" keyProperty="empId">
		INSERT
		INTO m_employee (
		emp_name, hire_year, created_at, updated_at
		) VALUES (
		#{empName}, #{hireYear}, NOW(), NOW()
		)
	</insert>
</mapper>