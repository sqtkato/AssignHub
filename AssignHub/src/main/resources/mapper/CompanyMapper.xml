<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.assignhub.mapper.CompanyMapper">

	<resultMap id="companyResultMap"
		type="com.assignhub.entity.Company">
		<id property="companyId" column="company_id" />
		<result property="companyName" column="company_name" />
		<result property="createdAt" column="created_at" />
		<result property="updatedAt" column="updated_at" />
	</resultMap>

	<select id="findAll" resultMap="companyResultMap">
		SELECT *
		FROM m_company
		<if test="keyword != null and keyword != ''">
			<where>
				company_name LIKE CONCAT('%', #{keyword}, '%')
			</where>
		</if>
		ORDER BY ${sort} ${order}
	</select>

	<select id="findById" resultMap="companyResultMap">
		SELECT *
		FROM m_company
		WHERE
		company_id = #{id}
	</select>

	<insert id="insert" useGeneratedKeys="true"
		keyProperty="companyId">
		INSERT INTO m_company (
		company_name, created_at,
		updated_at
		) VALUES (
		#{companyName}, NOW(), NOW()
		)
	</insert>
</mapper>